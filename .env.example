# Copy to .env (never commit .env). All services bind to 127.0.0.1 by default.
MEDQUAD_BIND_HOST=127.0.0.1
MEDQUAD_API_PORT=8000
MEDQUAD_UI_PORT=8501
MEDQUAD_QDRANT_URL=http://127.0.0.1:6333
MEDQUAD_QDRANT_PATH=              # if set, use embedded/local Qdrant at this path (URL ignored)
MEDQUAD_RETRIEVER=hybrid          # bm25 | dense | hybrid (bm25 = lexical-only, no Qdrant/GPU)
MEDQUAD_INDEX_DIR=artifacts/indexes
MEDQUAD_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MEDQUAD_CORPUS_PATH=data/processed/corpus.jsonl
MEDQUAD_MODEL_DIR=artifacts/models
MEDQUAD_DEVICE=auto              # auto | cuda | cpu
MEDQUAD_LOG_CONTENT=false        # opt-in raw question/answer logging (off by default)
HF_HOME=                          # optional HF cache location
HF_TOKEN=                         # optional; only needed for gated models (none used by default)
